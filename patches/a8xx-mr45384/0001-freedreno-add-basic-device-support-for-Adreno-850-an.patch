From 66b3a084f1d7f878eb4a607c9b02f09ca42581d4 Mon Sep 17 00:00:00 2001
From: Lakshman Chandu Kondreddy <lkondred@qti.qualcomm.com>
Date: Wed, 14 Oct 2026 14:41:46 +0530
Subject: [PATCH 1/2] freedreno: add basic device support for Adreno 850 and
 845

Enable basic functionality of Adreno 850 and Adreno 845.

Signed-off-by: Lakshman Chandu Kondreddy <lkondred@qti.qualcomm.com>
Co-authored-by: Tupili Krishna Gowtham Reddy <tupilikr@qti.qualcomm.com>
---
 src/freedreno/common/freedreno_devices.py | 31 +++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 7ab1706fd81..af6b37ad510 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -1442,6 +1442,15 @@ a8xx_base_raw_magic_regs = [
         [A6XXRegs.REG_A8XX_PC_MODE_CNTL,    0x00003f00],
     ]
 
+a8xx_rb_fdm_raw_magic_regs = a8xx_base_raw_magic_regs + [
+        [A6XXRegs.REG_A8XX_RB_BIN_FOVEAT_XY_FDM_OFFSET + 0, 0x00000000],
+        [A6XXRegs.REG_A8XX_RB_BIN_FOVEAT_XY_FDM_OFFSET + 1, 0x00000000],
+        [A6XXRegs.REG_A8XX_RB_BIN_FOVEAT_XY_FDM_OFFSET + 2, 0x00000000],
+        [A6XXRegs.REG_A8XX_RB_BIN_FOVEAT_XY_FDM_OFFSET + 3, 0x00000000],
+        [A6XXRegs.REG_A8XX_RB_BIN_FOVEAT_XY_FDM_OFFSET + 4, 0x00000000],
+        [A6XXRegs.REG_A8XX_RB_BIN_FOVEAT_XY_FDM_OFFSET + 5, 0x00000000],
+    ]
+
 a8xx_gen1 = GPUProps(
         reg_size_vec4 = 96,
         sysmem_vpc_attr_buf_size = 131072,
@@ -1626,5 +1635,27 @@ add_gpus([
         raw_magic_regs = a8xx_base_raw_magic_regs,
     ))
 
+add_gpus([
+        GPUId(chip_id=0xffff44051431, name="Adreno (TM) 850"),
+        GPUId(chip_id=0xffff44041430, name="Adreno (TM) 845"),
+    ], A6xxGPUInfo(
+        CHIP.A8XX,
+        [a7xx_base, a7xx_gen3, a8xx_base, a8xx_gen2,
+         GPUProps(
+             shading_rate_matches_vk = True,
+         )],
+        num_ccu = 6,
+        num_slices = 3,
+        tile_align_w = 96,
+        tile_align_h = 32,
+        tile_max_w = 16416,
+        tile_max_h = 16384,
+        num_vsc_pipes = 32,
+        cs_shared_mem_size = 32 * 1024,
+        wave_granularity = 2,
+        fibers_per_sp = 128 * 2 * 16,
+        raw_magic_regs = a8xx_rb_fdm_raw_magic_regs,
+    ))
+
 if __name__ == "__main__":
     main()
-- 
2.53.0

