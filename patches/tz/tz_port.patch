+/* TurnipZ 0.3.0: swap R and B of color outputs whose render target is an
+ * R/B-swapped view of a tiled image (bit set in load_rt_swap_mask_ir3 at
+ * draw time). Only candidates from the shader key, and only full RGBA writes.
+ */
+static bool
+tz_lower_rt_swap(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const uint32_t candidates = *(const uint32_t *)data;
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   unsigned location = nir_intrinsic_io_semantics(intr).location;
+   if (location < FRAG_RESULT_DATA0 || location > FRAG_RESULT_DATA7)
+      return false;
+   unsigned rt = location - FRAG_RESULT_DATA0;
+   if (!(candidates & (1u << rt)))
+      return false;
+
+   nir_def *value = intr->src[0].ssa;
+   if (nir_intrinsic_component(intr) != 0 || value->num_components <= 2 ||
+       (nir_intrinsic_write_mask(intr) & 0x5) != 0x5)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *mask = nir_load_rt_swap_mask_ir3(b);
+   nir_def *swap = nir_ine_imm(b, nir_iand_imm(b, mask, 1u << rt), 0);
+   nir_def *chans[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned i = 0; i < value->num_components; i++)
+      chans[i] = nir_channel(b, value, i);
+   nir_def *x = chans[0];
+   chans[0] = nir_bcsel(b, swap, chans[2], x);
+   chans[2] = nir_bcsel(b, swap, x, chans[2]);
+   nir_src_rewrite(&intr->src[0], nir_vec(b, chans, value->num_components));
+   return true;
+}
