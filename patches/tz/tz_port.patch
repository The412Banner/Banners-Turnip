+/* TurnipZ 0.3.0 (AlexSanz0902) mutable-image and BGRA handling, rebuilt from
+ * its driver binary (Banners-Turnip). Images seen with an R/B-swapped view
+ * that cannot be fixed by a swizzle are remembered by their create
+ * parameters and size; later images with the same key get the upstream
+ * linear fallback from the start.
+ */
+static std::mutex tz_swap_mutex;
+static std::unordered_set<uint64_t> tz_swap_set;
+
+static uint64_t
+tz_image_key(const struct tu_image *image)
+{
+   uint64_t h = image->tz_hash ^ 0x5357415053574150ull ^
+                ((uint64_t)image->vk.extent.width |
+                 (uint64_t)image->vk.extent.height << 20 |
+                 (uint64_t)image->vk.extent.depth << 40);
+   return h ? h * 0x100000001b3ull : 1;
+}
+
+void
+tu_tz_note_swapped_image(const struct tu_image *image)
+{
+   std::lock_guard<std::mutex> lock(tz_swap_mutex);
+   tz_swap_set.insert(tz_image_key(image));
+}
+
+static bool
+tz_image_seen_swapped(const struct tu_image *image)
+{
+   std::lock_guard<std::mutex> lock(tz_swap_mutex);
+   return tz_swap_set.count(tz_image_key(image)) != 0;
+}
+
+/* FNV-1a over the create parameters TurnipZ hashes. */
+static uint64_t
+tz_create_hash(const VkImageCreateInfo *ci)
+{
+   const uint32_t v[] = {
+      (uint32_t)ci->format, (uint32_t)ci->usage, (uint32_t)ci->flags,
+      (uint32_t)ci->imageType, ci->mipLevels, ci->arrayLayers,
+      (uint32_t)ci->samples,
+   };
+   uint64_t h = 0xcbf29ce484222325ull;
+   for (uint32_t x : v)
+      h = (h ^ x) * 0x100000001b3ull;
+   return h < 2 ? 1 : h;
+}
+
+/* TurnipZ mutable level 4: formats whose mutable images keep UBWC. */
+static bool
+tz_mutable_keep_format(const struct fd_dev_info *info, VkFormat format)
+{
+   if (vk_format_is_depth_or_stencil(format))
+      return true;
+
+   enum pipe_format pf = vk_format_to_pipe_format(format);
+   const struct util_format_description *desc = util_format_description(pf);
+   if (desc && desc->block.bits == 8 && desc->nr_channels == 1)
+      return true;
+
+   switch (pf) {
+   case PIPE_FORMAT_R32_UINT:
+   case PIPE_FORMAT_R32G32_UINT:
+   case PIPE_FORMAT_R32G32B32A32_UINT:
+   case PIPE_FORMAT_R32_SINT:
+   case PIPE_FORMAT_R32G32_SINT:
+   case PIPE_FORMAT_R32G32B32A32_SINT:
+   case PIPE_FORMAT_R16G16_UINT:
+   case PIPE_FORMAT_R16G16B16A16_UINT:
+   case PIPE_FORMAT_R16G16_SINT:
+   case PIPE_FORMAT_R16G16B16A16_SINT:
+   case PIPE_FORMAT_R16G16_UNORM:
+   case PIPE_FORMAT_R16G16B16A16_UNORM:
+   case PIPE_FORMAT_R8G8_UINT:
+   case PIPE_FORMAT_R8G8B8A8_UINT:
+   case PIPE_FORMAT_R8G8_SINT:
+   case PIPE_FORMAT_R8G8B8A8_SINT:
+   case PIPE_FORMAT_R8G8_UNORM:
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+   case PIPE_FORMAT_R8G8_SRGB:
+   case PIPE_FORMAT_R8G8B8A8_SRGB:
+   case PIPE_FORMAT_B8G8R8A8_SRGB:
+      return true;
+   case PIPE_FORMAT_R16G16_SNORM:
+   case PIPE_FORMAT_R16G16B16A16_SNORM:
+   case PIPE_FORMAT_R8G8_SNORM:
+   case PIPE_FORMAT_R8G8B8A8_SNORM:
+      return info->props.ubwc_unorm_snorm_int_compatible;
+   default:
+      return false;
+   }
+}
