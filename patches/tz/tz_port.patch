+/* TurnipZ BGRA level 3: plain 32-bit 4-channel colour format. */
+bool
+tu_tz_rt_swap_candidate(VkFormat format)
+{
+   if (vk_format_is_depth_or_stencil(format))
+      return false;
+   const struct util_format_description *desc =
+      util_format_description(vk_format_to_pipe_format(format));
+   return desc && desc->block.width < 2 &&
+          desc->layout == UTIL_FORMAT_LAYOUT_PLAIN &&
+          desc->block.bits == 32 && desc->nr_channels == 4;
+}
+
+static int
+tz_swizzle_index(const unsigned char *swz, unsigned char c)
+{
+   if (swz[3] == c)
+      return 3;
+   if (swz[2] == c)
+      return 2;
+   if (swz[1] == c)
+      return 1;
+   return swz[0] == c ? 0 : -1;
+}
+
+/* TurnipZ BGRA level 3: a view whose format differs from the tiled image
+ * only by an R/B swap samples through a ZYXW-composed swizzle and is marked
+ * tz_swap (render targets and clears swap too). Any other swapped view of a
+ * tiled level puts the image into the swapped-image set.
+ */
+static void
+tz_view_check_swap(struct tu_image *image, struct tu_image_view *iview,
+                   uint32_t base_mip, unsigned char *swiz)
+{
+   const struct fdl_layout *layout = &image->layout[0];
+   if (!layout->tile_mode)
+      return;
+   if (!layout->tile_all &&
+       MAX2(layout->width0 >> base_mip, 1u) < layout->linear_fallback_threshold_texels)
+      return;
+
+   enum pipe_format pf_image = vk_format_to_pipe_format(image->vk.format);
+   enum pipe_format pf_view = vk_format_to_pipe_format(iview->vk.format);
+   if (fd6_color_swap(pf_image, TILE6_LINEAR, false) ==
+       fd6_color_swap(pf_view, TILE6_LINEAR, false))
+      return;
+
+   if (tu_tz_rt_swap_candidate(image->vk.format) && tu_tz_rt_swap_candidate(iview->vk.format)) {
+      const struct util_format_description *di = util_format_description(pf_image);
+      const struct util_format_description *dv = util_format_description(pf_view);
+      bool same_sizes = true;
+      for (unsigned i = 0; i < 4; i++) {
+         if (di->channel[i].size != dv->channel[i].size)
+            same_sizes = false;
+      }
+      if (same_sizes && dv->swizzle[0] < 4 && dv->swizzle[1] < 4 &&
+          dv->swizzle[2] < 4) {
+         int x = tz_swizzle_index(di->swizzle, dv->swizzle[0]);
+         int y = tz_swizzle_index(di->swizzle, dv->swizzle[1]);
+         int z = tz_swizzle_index(di->swizzle, dv->swizzle[2]);
+         if (x >= 0 && y >= 0 && z >= 0 && dv->swizzle[3] < 4 &&
+             dv->swizzle[3] == di->swizzle[3]) {
+            if (y == 1 && x == 0 && z == 2)
+               return;
+            if (y == 1 && x == 2 && z == 0) {
+               static const unsigned char zyxw[4] = {
+                  PIPE_SWIZZLE_Z, PIPE_SWIZZLE_Y, PIPE_SWIZZLE_X, PIPE_SWIZZLE_W,
+               };
+               unsigned char old_swiz[4];
+               memcpy(old_swiz, swiz, sizeof(old_swiz));
+               util_format_compose_swizzles(zyxw, old_swiz, swiz);
+               iview->tz_swap = true;
+               return;
+            }
+         }
+      }
+   }
+
+   tu_tz_note_swapped_image(image);
+}
